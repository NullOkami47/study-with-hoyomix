# Optional client-side build and development variables.
# Never place secrets, API keys, or private credentials in VITE_* variables.

VITE_ENABLE_DEMO_CATALOG=false

# Optional static analytics script integration (used only when both are configured)
# VITE_ANALYTICS_ID=
# VITE_ANALYTICS_URL=

# Release build (`vite build`) CSP policy inputs (required in `production` / `staging` modes)
# RESPONSE_POLICY_PUBLIC_ORIGIN=https://your-domain.example
# RESPONSE_POLICY_R2_BASE_URL=https://media.your-domain.example/
# LX_ALLOWED_ORIGINS=
